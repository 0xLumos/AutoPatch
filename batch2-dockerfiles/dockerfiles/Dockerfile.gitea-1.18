FROM gitea/gitea:1.18
LABEL maintainer="devops@example.com" \
      description="Gitea 1.18 git service"

EXPOSE 3000 22

ENV GITEA__SERVER__ROOT_URL=http://localhost:3000 \
    GITEA__SERVER__PROTOCOL=http \
    GITEA__DATABASE__TYPE=sqlite3 \
    GITEA__SERVICE__DEFAULT_KEEP_EMAIL_PRIVATE=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY app.ini /etc/gitea/app.ini || true

VOLUME ["/data", "/etc/gitea"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

CMD ["/usr/bin/gitea", "web"]
