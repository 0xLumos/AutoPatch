FROM couchdb:3.2
LABEL maintainer="devops@example.com" \
      description="CouchDB 3.2 document database"

EXPOSE 5984 5986

ENV COUCHDB_USER=admin \
    COUCHDB_PASSWORD=password \
    COUCHDB_SECRET=supersecret

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY local.ini /opt/couchdb/etc/local.ini || true
RUN echo "[httpd]" > /opt/couchdb/etc/local.ini && \
    echo "bind_address = 0.0.0.0" >> /opt/couchdb/etc/local.ini

VOLUME ["/opt/couchdb/data"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5984/ || exit 1

CMD ["/opt/couchdb/bin/couchdb"]
