FROM mediawiki:1.38
LABEL maintainer="devops@example.com" \
      description="MediaWiki 1.38 wiki platform"

EXPOSE 80

ENV MEDIAWIKI_SITE_SERVER=localhost \
    MEDIAWIKI_SITE_NAME=MyWiki

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY LocalSettings.php /var/www/html/LocalSettings.php || true
RUN echo "<?php" > /var/www/html/LocalSettings.php

VOLUME ["/var/www/html/images"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

CMD ["apache2-foreground"]
