FROM influxdb:1.8
LABEL maintainer="devops@example.com" \
      description="InfluxDB 1.8 time-series database"

EXPOSE 8086 8083

ENV INFLUXDB_DB=defaultdb \
    INFLUXDB_ADMIN_USER=admin \
    INFLUXDB_ADMIN_PASSWORD=admin

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY influxdb.conf /etc/influxdb/influxdb.conf || true

VOLUME ["/var/lib/influxdb"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8086/ping || exit 1

CMD ["influxd", "-config", "/etc/influxdb/influxdb.conf"]
